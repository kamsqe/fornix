---
import FlipText from "./FlipText.astro";
import type { Flight } from "../data/flights.ts";
import { flightSlug } from "../data/flights.ts";

interface Props {
  flight: Flight;
}
const { flight } = Astro.props;

const statusClass = {
  "BOARDING": "pill--boarding",
  "ON TIME":  "pill--ontime",
  "DEPARTED": "pill--departed",
  "DELAYED":  "pill--delayed",
}[flight.status];

const href = `/flight/${flightSlug(flight.code)}/`;
---

<li class="row">
  <span class="row__flight">{flight.code}</span>

  <span class="row__dest">
    <a href={href} aria-label={`Board flight ${flight.code} to ${flight.destination}`}>
      <FlipText text={flight.destination} />
    </a>
  </span>

  <span class="row__gate">{flight.gate}</span>

  <span class="row__time">{flight.time}</span>

  {/* mobile stub — only visible under 720px (decorative gate label) */}
  <span class="row__stub" aria-hidden="true">
    <small>GATE</small>
    <b>{flight.gate}</b>
  </span>

  <span class="row__status">
    <span class={`pill ${statusClass}`}>{flight.status}</span>
  </span>
</li>
