---
// FlipText — renders a string as a row of split-flap characters.
// Each character is a .flap; spaces become non-flap gaps.
// The shuffle driver in Board.astro reads `data-final` on each <i>.

interface Props {
  text: string;
  /** disable the idle ambient re-shuffle for this row (e.g. on detail page) */
  idle?: boolean;
}

const { text, idle = true } = Astro.props;
const chars = text.toUpperCase().split("");
---

<span class="flip" data-idle={idle ? "on" : "off"} aria-label={text}>
  {chars.map((c) =>
    c === " " ? (
      <span class="flap flap--space" aria-hidden="true"></span>
    ) : (
      <span class="flap" aria-hidden="true"><i data-final={c}>{c}</i></span>
    )
  )}
</span>
