---
// Single layout. Both the index and the flight pages use it.
// The board chrome (header + ticker) is here; the body slot is each page's content.

import "../styles/global.css";
import { studio } from "../data/studio.ts";

interface Props {
  title: string;
  description: string;
  /** if true, omits the legend/columns header (used on the flight detail) */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;

const tickerItems = [
  `LOCAL ${studio.timezone}`,
  `BASE ${studio.baseLabel}`,
  `${studio.callsign} · DESIGN AND ENGINEERING`,
  "MANIFEST UPDATED 0900 LOCAL",
  "PASSENGERS WITH NDA SHOULD PROCEED TO GATE C17",
  `EST. ${studio.established}`,
  `FLEET ${String(studio.fleet).padStart(2, "0")}`,
  "TYPE THE FLIGHT CODE TO BOARD",
];
// duplicated so the CSS marquee can loop seamlessly
const tickerLoop = [...tickerItems, ...tickerItems];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#07060a" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%23141210'/%3E%3Ctext x='8' y='12' text-anchor='middle' font-family='monospace' font-weight='700' font-size='10' fill='%23ffb000'%3ET7%3C/text%3E%3C/svg%3E" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="head">
        <div class="head__top">
          <div class="callsign">
            <b>{studio.name}</b>
            <span>/ {studio.subtitle}</span>
          </div>
          <div class="clock" aria-live="off">
            <small>{studio.timezone}</small>
            <time id="clock" datetime="">—— : ——</time>
            <small>{studio.baseLabel}</small>
          </div>
        </div>

        {!bare && (
          <div class="head__legend" role="row">
            <span>FLIGHT</span>
            <span>DESTINATION</span>
            <span>GATE</span>
            <span>DEP</span>
            <span>STATUS</span>
          </div>
        )}
      </header>

      <main>
        <slot />
      </main>

      <footer class="ticker" aria-hidden="true">
        <div class="ticker__inner">
          {tickerLoop.map((t) => <span>{t}</span>)}
        </div>
      </footer>
    </div>

    {/* tiny clock + flap shuffle driver — ~1KB, no framework */}
    <script>
      // ── live clock ───────────────────────────────────────────────────────
      const clock = document.getElementById("clock");
      const pad = (n: number) => String(n).padStart(2, "0");
      function tick() {
        const d = new Date();
        // intentionally render in the studio's nominal timezone label;
        // we just show user-local but format as 24h to fit the board.
        const t = `${pad(d.getHours())} : ${pad(d.getMinutes())}`;
        if (clock) clock.textContent = t;
        if (clock) clock.setAttribute("datetime", d.toISOString());
      }
      tick();
      setInterval(tick, 30_000);

      // ── flap shuffle ─────────────────────────────────────────────────────
      // For each .flip, scramble each character a few times, then land it on
      // the final letter. Respects prefers-reduced-motion (handled in CSS).
      const ALPH = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const flips = document.querySelectorAll<HTMLElement>(".flip");

      flips.forEach((flip, rowIndex) => {
        const flaps = flip.querySelectorAll<HTMLElement>(".flap > i");
        flaps.forEach((el, i) => {
          const target = el.dataset.final ?? el.textContent ?? " ";
          if (reduce || target === " ") {
            el.textContent = target;
            return;
          }
          const steps = 6 + ((i + rowIndex) % 4); // 6–9 random flips
          const delay = 80 + i * 55 + rowIndex * 90;
          let s = 0;
          const intv = setInterval(() => {
            if (s++ >= steps) {
              clearInterval(intv);
              el.textContent = target;
              const parent = el.parentElement;
              if (parent) {
                parent.classList.add("is-settling");
                setTimeout(() => parent.classList.remove("is-settling"), 140);
              }
              return;
            }
            el.textContent = ALPH[(Math.random() * ALPH.length) | 0];
          }, 55);
          setTimeout(() => {}, delay);
        });
      });

      // ── idle re-shuffle of one random row every 9s, for ambience ────────
      if (!reduce && flips.length) {
        setInterval(() => {
          const candidates = Array.from(flips).filter(
            (f) => f.dataset.idle !== "off"
          );
          if (!candidates.length) return;
          const pick = candidates[(Math.random() * candidates.length) | 0];
          const flaps = pick.querySelectorAll<HTMLElement>(".flap > i");
          flaps.forEach((el, i) => {
            const target = el.dataset.final ?? el.textContent ?? " ";
            if (target === " ") return;
            const steps = 4 + (i % 3);
            let s = 0;
            const intv = setInterval(() => {
              if (s++ >= steps) {
                clearInterval(intv);
                el.textContent = target;
                return;
              }
              el.textContent = ALPH[(Math.random() * ALPH.length) | 0];
            }, 60);
          });
        }, 9000);
      }
    </script>
  </body>
</html>
