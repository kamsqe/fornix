---
/**
 * <Field /> — WebGL2 background.
 *
 * Hand-rolled fragment shader: domain-warped simplex fbm + cursor halo + vignette + grain.
 * Monochrome by design (ink + cream). Falls back to a CSS gradient when WebGL is unavailable
 * or when the viewport is too small to make it worth the GPU cost.
 *
 * Coordinates flow top-left → bottom-right. Time advances slowly (0.05x).
 */
---

<canvas id="liminal-field" aria-hidden="true"></canvas>
<div id="liminal-field-fallback" aria-hidden="true"></div>

<style>
  #liminal-field,
  #liminal-field-fallback {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  #liminal-field-fallback {
    display: none;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(232, 228, 213, 0.06) 0%, transparent 40%),
      radial-gradient(ellipse at 70% 80%, rgba(232, 228, 213, 0.04) 0%, transparent 50%),
      var(--ink-000);
  }

  /* On low-power devices skip the shader altogether */
  @media (prefers-reduced-motion: reduce) {
    #liminal-field { display: none; }
    #liminal-field-fallback { display: block; }
  }
</style>

<script>
  /* ───────────────────────────────────────────────────────────
     LIMINAL · field.ts
     ─────────────────────────────────────────────────────────── */

  const VERT = /* glsl */ `#version 300 es
    in vec2 a_pos;
    void main() {
      gl_Position = vec4(a_pos, 0.0, 1.0);
    }
  `;

  const FRAG = /* glsl */ `#version 300 es
    precision highp float;
    out vec4 outColor;

    uniform vec2  u_resolution;
    uniform vec2  u_mouse;
    uniform float u_time;
    uniform float u_quality; // 1.0 desktop, 0.5 mobile
    uniform float u_settle;  // 0 → 1 after boot

    // ── simplex noise (Ashima) ────────────────────────────────
    vec3 mod289(vec3 x){ return x - floor(x * (1.0/289.0)) * 289.0; }
    vec2 mod289(vec2 x){ return x - floor(x * (1.0/289.0)) * 289.0; }
    vec3 permute(vec3 x){ return mod289(((x*34.0)+1.0)*x); }

    float snoise(vec2 v){
      const vec4 C = vec4(0.211324865405187, 0.366025403784439,
                          -0.577350269189626, 0.024390243902439);
      vec2 i  = floor(v + dot(v, C.yy));
      vec2 x0 = v -   i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz;
      x12.xy -= i1;
      i = mod289(i);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0))
            + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy),
                              dot(x12.zw,x12.zw)), 0.0);
      m = m*m; m = m*m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);
      vec3 g;
      g.x  = a0.x  * x0.x  + h.x  * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }

    // ── domain-warped fractal ────────────────────────────────
    float fbm(vec2 p, int octaves){
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 5; i++) {
        if (i >= octaves) break;
        v += a * snoise(p);
        p *= 2.02;
        a *= 0.5;
      }
      return v;
    }

    void main(){
      vec2 res = u_resolution;
      vec2 uv = gl_FragCoord.xy / res;
      vec2 p = uv * 2.0 - 1.0;
      p.x *= res.x / res.y;

      vec2 mouse = (u_mouse / res) * 2.0 - 1.0;
      mouse.y = -mouse.y;
      mouse.x *= res.x / res.y;

      float t = u_time * 0.04;
      int oct = u_quality > 0.75 ? 5 : 3;

      // First warp
      vec2 q = vec2(
        fbm(p + vec2(0.0, t),       oct),
        fbm(p + vec2(5.2, 1.3 + t), oct)
      );

      // Second warp (deeper folds)
      vec2 r = vec2(
        fbm(p + 1.4 * q + vec2(1.7, 9.2) + 0.13 * t, oct),
        fbm(p + 1.4 * q + vec2(8.3, 2.8) + 0.097 * t, oct)
      );

      float n = fbm(p + 1.8 * r, oct);

      // Cursor halo — soft, only on hover devices
      float d = length(p - mouse);
      float halo = smoothstep(0.55, 0.0, d) * 0.18;

      // Palette
      vec3 ink   = vec3(0.0, 0.0, 0.0);
      vec3 char_ = vec3(0.078, 0.078, 0.082);
      vec3 cream = vec3(0.913, 0.894, 0.835);

      float ridge = smoothstep(0.30, 0.62, n);
      vec3 col = mix(ink, char_, ridge);
      col = mix(col, cream * 0.22, smoothstep(0.55, 0.95, n) * 0.65);
      col += halo * cream * 0.25;

      // Vignette
      float vig = smoothstep(1.7, 0.45, length(p) * 0.95);
      col *= vig;

      // Settle wipe on boot (top-down reveal)
      float wipe = smoothstep(u_settle - 0.2, u_settle + 0.05, uv.y * 0.5 + 0.5 - 0.5);
      col *= mix(0.05, 1.0, smoothstep(0.0, 1.0, u_settle));

      // Stochastic grain
      float g = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233)) + u_time * 0.001) * 43758.5453) - 0.5;
      col += g * 0.018;

      outColor = vec4(col, 1.0);
    }
  `;

  function field() {
    const canvas = document.getElementById("liminal-field") as HTMLCanvasElement | null;
    const fallback = document.getElementById("liminal-field-fallback") as HTMLElement | null;
    if (!canvas) return;

    const gl = canvas.getContext("webgl2", { antialias: false, alpha: false, powerPreference: "low-power" });
    if (!gl) {
      canvas.style.display = "none";
      if (fallback) fallback.style.display = "block";
      return;
    }

    // ── compile + link ──
    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
        console.error(gl.getShaderInfoLog(sh));
        gl.deleteShader(sh);
        return null;
      }
      return sh;
    };

    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) {
      canvas.style.display = "none";
      if (fallback) fallback.style.display = "block";
      return;
    }

    const program = gl.createProgram()!;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.error(gl.getProgramInfoLog(program));
      canvas.style.display = "none";
      if (fallback) fallback.style.display = "block";
      return;
    }

    gl.useProgram(program);

    // ── fullscreen quad ──
    const vao = gl.createVertexArray();
    gl.bindVertexArray(vao);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    const aPos = gl.getAttribLocation(program, "a_pos");
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(program, "u_resolution");
    const uMouse = gl.getUniformLocation(program, "u_mouse");
    const uTime = gl.getUniformLocation(program, "u_time");
    const uQual = gl.getUniformLocation(program, "u_quality");
    const uSettle = gl.getUniformLocation(program, "u_settle");

    const isMobile = window.matchMedia("(max-width: 720px)").matches;
    const quality = isMobile ? 0.5 : 1.0;
    const dpr = Math.min(window.devicePixelRatio || 1, isMobile ? 1.5 : 2);

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let mouseTargetX = mouseX;
    let mouseTargetY = mouseY;

    const onMove = (e: PointerEvent) => {
      mouseTargetX = e.clientX;
      mouseTargetY = e.clientY;
    };
    window.addEventListener("pointermove", onMove, { passive: true });

    const resize = () => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      canvas.style.width = w + "px";
      canvas.style.height = h + "px";
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    resize();
    window.addEventListener("resize", resize);

    const start = performance.now();
    let raf = 0;
    const render = (now: number) => {
      // smooth mouse
      mouseX += (mouseTargetX - mouseX) * 0.05;
      mouseY += (mouseTargetY - mouseY) * 0.05;

      const t = (now - start) / 1000;
      const settle = Math.min(1, t / 1.2);

      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform2f(uMouse, mouseX * dpr, mouseY * dpr);
      gl.uniform1f(uTime, t);
      gl.uniform1f(uQual, quality);
      gl.uniform1f(uSettle, settle);

      gl.drawArrays(gl.TRIANGLES, 0, 3);
      raf = requestAnimationFrame(render);
    };
    raf = requestAnimationFrame(render);

    // pause when tab is hidden
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
      } else {
        raf = requestAnimationFrame(render);
      }
    });
  }

  // boot once and survive view transitions
  field();
  document.addEventListener("astro:after-swap", () => {
    // canvas is part of the persisted shell, but in case of cold nav re-init.
    if (!document.getElementById("liminal-field")) return;
    // The shader keeps running; nothing to do.
  });
</script>
