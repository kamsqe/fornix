---
const { pathname } = Astro.url;
const items = [
  { num: "00", label: "INDEX",     href: "/" },
  { num: "01", label: "WORK",      href: "/work/" },
  { num: "02", label: "MANIFESTO", href: "/manifesto/" },
  { num: "03", label: "CONTACT",   href: "/contact/" },
];
const isCurrent = (href: string) => {
  if (href === "/") return pathname === "/" || pathname === "";
  return pathname.startsWith(href);
};
---

<nav class="nav" aria-label="Primary">
  <ol>
    {items.map((it) => (
      <li class:list={["nav-item", { "is-current": isCurrent(it.href) }]}>
        <a href={it.href} data-astro-prefetch>
          <span class="num mono">{it.num}</span>
          <span class="label">{it.label}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .nav {
    position: fixed;
    top: var(--space-m);
    right: var(--space-m);
    z-index: 60;
  }

  .nav ol {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: flex-end;
  }

  .nav a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    padding: 4px 0;
    color: var(--cream-400);
    transition: color 0.4s var(--ease-out), letter-spacing 0.4s var(--ease-out);
  }

  .nav a:hover {
    color: var(--cream-100);
    letter-spacing: 0.22em;
  }

  .nav .num {
    font-size: var(--step--2);
    color: var(--cream-300);
    font-variant-numeric: tabular-nums;
  }

  .nav-item.is-current a {
    color: var(--cream-100);
  }

  .nav-item.is-current::before {
    content: "";
    display: inline-block;
    width: 12px;
    height: 1px;
    background: var(--cream-100);
    margin-right: var(--space-2xs);
    vertical-align: middle;
  }

  @media (max-width: 720px) {
    .nav {
      top: auto;
      bottom: var(--space-s);
      left: var(--space-s);
      right: var(--space-s);
    }
    .nav ol {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-2xs);
    }
    .nav a {
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
    .nav-item.is-current::before {
      display: none;
    }
    .nav-item.is-current a::after {
      content: "";
      display: block;
      width: 14px;
      height: 1px;
      background: var(--cream-100);
      margin-top: 2px;
    }
  }
</style>
