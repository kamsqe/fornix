---
import Shell from "../layouts/Shell.astro";
---

<Shell title="Contact" sigil="SIGNAL" index="03 / 04" description="One channel, two coordinates, three rules.">
  <section class="contact">
    <header class="contact-head rise rise-1">
      <p class="label">↳ One channel, three rules</p>
      <h1 class="display contact-title">
        <span>Write</span>
        <em>plainly.</em>
      </h1>
    </header>

    <div class="contact-grid">
      <div class="contact-col contact-col--primary rise rise-2">
        <p class="contact-label label">[ signal ]</p>
        <a class="contact-line display" href="mailto:hello@liminal.example">
          hello<span class="at">@</span>liminal.example
        </a>
        <p class="contact-note">
          Replies arrive within a week. If something more urgent, write the word
          <code>urgent</code> in the first line; that filters into a different folder.
        </p>
      </div>

      <div class="contact-col rise rise-3">
        <p class="contact-label label">[ coordinates ]</p>
        <ul class="contact-list">
          <li><span class="k">Lat</span><span class="v mono">52.5200° N</span></li>
          <li><span class="k">Lon</span><span class="v mono">13.4050° E</span></li>
          <li><span class="k">Tz</span><span class="v mono">UTC+01 · CET</span></li>
          <li><span class="k">Hrs</span><span class="v mono">10:00 → 18:00</span></li>
        </ul>
      </div>

      <div class="contact-col rise rise-4">
        <p class="contact-label label">[ house rules ]</p>
        <ol class="contact-rules">
          <li><span class="k mono">01</span>One project at a time.</li>
          <li><span class="k mono">02</span>No NDAs that read as gag orders.</li>
          <li><span class="k mono">03</span>If you can build it, build it.</li>
        </ol>
      </div>

      <div class="contact-col contact-col--span rise rise-5">
        <p class="contact-label label">[ elsewhere ]</p>
        <ul class="contact-handles">
          <li><a href="#" data-cursor="link">are.na<span class="mono">/liminal</span></a></li>
          <li><a href="#" data-cursor="link">github<span class="mono">/liminal-studio</span></a></li>
          <li><a href="#" data-cursor="link">read.cv<span class="mono">/m</span></a></li>
        </ul>
      </div>
    </div>

    <p class="contact-end rise rise-6">— end of transmission —</p>
  </section>
</Shell>

<style>
  .contact {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .contact-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .contact-title {
    font-size: var(--step-8);
    line-height: 0.92;
  }
  .contact-title em {
    color: var(--blood);
    margin-left: 0.15em;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-l);
    border-top: 1px solid var(--ink-300);
    padding-top: var(--space-l);
  }

  .contact-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }
  .contact-col--span {
    grid-column: 1 / -1;
    border-top: 1px solid var(--ink-300);
    padding-top: var(--space-l);
  }

  .contact-label {
    color: var(--cream-400);
  }

  .contact-line {
    font-size: var(--step-5);
    color: var(--cream-100);
    line-height: 1;
    letter-spacing: -0.04em;
    word-break: break-word;
  }
  .contact-line .at {
    color: var(--blood);
    font-style: italic;
  }
  .contact-line:hover {
    color: var(--cream-100);
  }

  .contact-note {
    color: var(--cream-300);
    max-width: 50ch;
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .contact-note code {
    background: var(--ink-200);
    padding: 1px 6px;
    color: var(--cream-100);
    font-size: 0.92em;
  }

  .contact-list,
  .contact-rules,
  .contact-handles {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .contact-list li,
  .contact-rules li {
    display: grid;
    grid-template-columns: 4ch 1fr;
    gap: var(--space-s);
    font-size: var(--step--1);
    color: var(--cream-200);
  }
  .contact-list .k,
  .contact-rules .k {
    color: var(--cream-400);
  }
  .contact-rules .k {
    font-variant-numeric: tabular-nums;
  }

  .contact-handles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }
  .contact-handles a {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-size: var(--step-1);
    color: var(--cream-200);
  }
  .contact-handles .mono {
    color: var(--cream-400);
    font-size: var(--step--1);
  }
  .contact-handles a:hover {
    color: var(--cream-100);
  }

  .contact-end {
    text-align: center;
    color: var(--cream-400);
    font-size: var(--step--2);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding-top: var(--space-xl);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
    .contact-col--primary {
      grid-column: 1 / -1;
    }
    .contact-handles {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
  }

  @media (max-width: 560px) {
    .contact-title { font-size: var(--step-6); }
    .contact-line { font-size: var(--step-3); }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>
