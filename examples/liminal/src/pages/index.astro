---
import Shell from "../layouts/Shell.astro";
---

<Shell title="Index" sigil="ENTRY" index="00 / 04" description="Liminal — an anti-template for Astro.">
  <section class="hero">
    <p class="hero-label label rise rise-1">A signal from somewhere quieter</p>

    <h1 class="hero-title display rise rise-2">
      <span class="hero-line">The web</span>
      <span class="hero-line hero-line--shift">does not</span>
      <span class="hero-line">need another</span>
      <span class="hero-line hero-line--accent"><em>template.</em></span>
    </h1>

    <div class="hero-meta rise rise-4">
      <p class="hero-blurb">
        <span class="dim">↳</span>
        Liminal is what's left when you remove the hero, the features, the
        pricing tier, and the conviction that all of them were necessary.
      </p>
      <a class="hero-cta" href="/manifesto/" data-astro-prefetch>
        <span class="hero-cta-num mono">→ 02</span>
        <span class="hero-cta-label">Read the manifesto</span>
      </a>
    </div>

    <ul class="hero-stats rise rise-5">
      <li><span class="num mono">04</span><span class="label">Pages</span></li>
      <li><span class="num mono">01</span><span class="label">Shader</span></li>
      <li><span class="num mono">00</span><span class="label">Dependencies</span></li>
      <li><span class="num mono">∞</span><span class="label">Restraint</span></li>
    </ul>
  </section>
</Shell>

<style>
  .hero {
    max-width: min(1400px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    padding-top: var(--space-2xl);
  }

  .hero-label {
    display: inline-block;
    border-top: 1px solid var(--cream-400);
    padding-top: var(--space-2xs);
    width: max-content;
  }

  .hero-title {
    font-size: var(--step-8);
    max-width: 18ch;
  }

  .hero-line {
    display: block;
  }
  .hero-line--shift {
    padding-left: clamp(0.5rem, 6vw, 6rem);
  }
  .hero-line--accent {
    color: var(--cream-200);
  }
  .hero-line--accent em {
    font-style: italic;
    color: var(--blood);
    margin-left: 0.1em;
  }

  .hero-meta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-l);
    align-items: end;
    border-top: 1px solid var(--ink-300);
    padding-top: var(--space-m);
  }

  .hero-blurb {
    max-width: 56ch;
    font-size: var(--step-0);
    color: var(--cream-200);
    line-height: 1.55;
  }
  .hero-blurb .dim {
    color: var(--cream-400);
    margin-right: 0.5ch;
  }

  .hero-cta {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--cream-400);
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }
  .hero-cta:hover {
    border-color: var(--cream-100);
    background: rgba(232, 228, 213, 0.04);
  }
  .hero-cta-num {
    color: var(--cream-300);
    font-size: var(--step--2);
  }
  .hero-cta-label {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
    border-top: 1px solid var(--ink-300);
    padding-top: var(--space-m);
  }
  .hero-stats li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .hero-stats .num {
    font-size: var(--step-2);
    font-family: "Times New Roman", "Times", serif;
    font-style: italic;
    color: var(--cream-100);
    line-height: 1;
  }

  @media (max-width: 720px) {
    .hero {
      gap: var(--space-l);
      padding-top: var(--space-l);
    }
    .hero-title {
      font-size: var(--step-6);
    }
    .hero-line--shift {
      padding-left: 1.5rem;
    }
    .hero-meta {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-s);
    }
  }
</style>
