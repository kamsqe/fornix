{
  "name": "fornix",
  "version": "0.0.0",
  "private": true,
  "description": "CLI-first Astro + Cloudflare project generator",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm --filter create-fornix run test:integration",
    "test:e2e": "pnpm --filter create-fornix run test:e2e",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "showcase": "node scripts/build-showcase.mjs",
    "showcase:dev": "node scripts/build-showcase.mjs && cd examples/showcase && npx astro preview",
    "showcase:deploy": "node scripts/build-showcase.mjs && cd examples/showcase && npx wrangler pages deploy dist --project-name fornix-showcase"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
