{
  "name": "create-fornix",
  "version": "0.0.3",
  "description": "CLI-first Astro + Cloudflare project generator",
  "type": "module",
  "license": "MIT",
  "bin": {
    "create-fornix": "dist/index.js",
    "fornix": "dist/index.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@clack/prompts": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ai": "^4.3.19",
    "citty": "^0.1.6",
    "defu": "^6.1.4",
    "fast-glob": "^3.3.3",
    "giget": "^1.2.3",
    "magicast": "^0.3.5",
    "picocolors": "^1.1.0",
    "pkg-types": "^1.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "acorn": "^8.16.0",
    "execa": "^9.5.0",
    "fornix-registry": "workspace:*",
    "memfs": "^4.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
