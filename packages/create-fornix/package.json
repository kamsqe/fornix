{
  "name": "create-fornix",
  "version": "0.3.0",
  "description": "Scaffold a production-ready Astro site in one command. 5 archetypes (SaaS, agency, portfolio, gym, restaurant), 13 hand-built blocks, 7 design palettes, multi-page sites, multi-deploy-target configs (Cloudflare/Vercel/Netlify), and AGENTS.md emission so Claude Code & Cursor can pick up where the CLI left off.",
  "type": "module",
  "license": "MIT",
  "author": "kambar <kambar.mirmanov@gmail.com> (https://github.com/kamsqe)",
  "homepage": "https://github.com/kamsqe/fornix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamsqe/fornix.git",
    "directory": "packages/create-fornix"
  },
  "bugs": {
    "url": "https://github.com/kamsqe/fornix/issues"
  },
  "keywords": [
    "astro",
    "cloudflare",
    "cli",
    "scaffolder",
    "ai",
    "anthropic",
    "claude",
    "blocks",
    "i18n",
    "generator",
    "create-app"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "create-fornix": "./dist/cli.js",
    "fornix": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "ai": "^6.0.183",
    "citty": "^0.1.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "fornix-registry": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
