{
  "name": "create-fornix",
  "version": "0.0.1",
  "description": "CLI-first Astro + Cloudflare project generator",
  "type": "module",
  "license": "MIT",
  "bin": {
    "create-fornix": "./dist/index.mjs",
    "fornix": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "@clack/prompts": "^0.9.1",
    "giget": "^1.2.3",
    "zod": "^3.24.0",
    "magicast": "^0.3.5",
    "pkg-types": "^1.3.0",
    "defu": "^6.1.4",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.10.0",
    "memfs": "^4.14.0",
    "execa": "^9.5.0"
  }
}
