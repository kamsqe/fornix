---
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  lang?: string;
};

const { title, description, lang = "{{defaultLocale}}" } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles/palettes/_current.css" id="fornix-palette-link" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: {{colorScheme}};
  }
  html,
  body {
    margin: 0;
    padding: 0;
    line-height: 1.5;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
</style>
