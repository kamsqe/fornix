[build]
  command = "astro build"
  publish = "dist"

[build.environment]
  NODE_VERSION = "20"

# Long-cache hashed Astro assets. The /_astro/ prefix is fingerprinted
# by Astro at build time, so cache-immutable is safe.
[[headers]]
  for = "/_astro/*"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

# Self-hosted fonts ship under /node_modules/@fontsource and are
# fingerprinted by Astro's build into /_astro/ — same rule covers them.
