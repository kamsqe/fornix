/**
 * Site-wide configuration consumed by every block in this project.
 * Edit any value here; it propagates everywhere automatically.
 *
 * Generated by Fornix. Safe to edit by hand or via AI editor.
 */

export interface SiteConfig {
  /** Project / brand name. Used in headers, footers, meta, page titles. */
  name: string;
  /** One-line tagline. Used in meta description + as a hero subhead fallback. */
  tagline?: string;
  /** Production URL (canonical + sitemap base). */
  url?: string;
  /** Archetype this site was scaffolded as. */
  archetype?: string;
  /** Default + supported locales. */
  locale: { default: string; supported: string[] };
  /** Brand logo strategy. */
  logo?: { type: "monogram" | "svg" | "wordmark"; text?: string; src?: string };
  /** Top-level navigation links. */
  nav?: Array<{ label: string; href: string }>;
  /** Primary CTA — used wherever a block doesn't override. */
  ctaPrimary?: { text: string; href: string };
  /** Secondary CTA. */
  ctaSecondary?: { text: string; href: string };
  /** Social handles (consumed by footer + meta tags). */
  social?: Record<string, string>;
  /** Contact info (consumed by contact + footer blocks). */
  contact?: { email?: string; phone?: string; address?: string };
  /** Legal / footer info. */
  legal?: { copyright?: string; privacyHref?: string; termsHref?: string };
  /** Meta tag overrides. */
  meta?: { ogImage?: string; twitterHandle?: string };
  /** Archetype-specific data (gym hours, restaurant menu, portfolio projects, ...). */
  archetypeMeta?: Record<string, unknown>;
}

export const site: SiteConfig = {{siteConfigJson}};
