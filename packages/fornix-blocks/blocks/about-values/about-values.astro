---
/**
 * About Values — values grid with proof points and optional featured card.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 * Content is read from `src/content/sections/about-values.json`.
 */
import { getEntry } from "astro:content";

interface Value {
  icon: string;
  name: string;
  statement: string;
  proof?: string;
  featured?: boolean;
  quote?: string;
  quoteAuthor?: string;
  quoteRole?: string;
}

const locale = Astro.currentLocale ?? "en";
const entry = await getEntry("sections", `${locale}/about-values`);
const {
  badge = "",
  headline = "",
  subheadline = "",
  ctaText = "",
  ctaHref = "#",
} = entry?.data ?? {};
const values = (entry?.data?.values ?? []) as Value[];
---

<section class="about-values">
  <div class="about-values__inner">
    <!-- Header -->
    <div class="about-values__header">
      {badge && <span class="about-values__badge">{badge}</span>}
      <h2 class="about-values__headline">{headline}</h2>
      {subheadline && <p class="about-values__subheadline">{subheadline}</p>}
    </div>

    <!-- Values Grid -->
    <div class="about-values__grid">
      {values.map((v, i) => (
        <div
          class:list={["about-values__card", v.featured && "about-values__card--featured"]}
          style={`animation-delay: ${i * 100}ms`}
        >
          {/* Icon */}
          <div class:list={["about-values__icon", v.featured && "about-values__icon--featured"]}>
            {v.icon}
          </div>

          {/* Name */}
          <h3 class:list={["about-values__name", v.featured && "about-values__name--featured"]}>
            {v.name}
          </h3>

          {/* Statement */}
          <p class="about-values__statement">{v.statement}</p>

          {/* Proof point */}
          {v.proof && (
            <div class:list={["about-values__proof", v.featured && "about-values__proof--featured"]}>
              <span class="about-values__proof-dot"></span>
              {v.proof}
            </div>
          )}

          {/* Featured quote */}
          {v.featured && v.quote && (
            <div class="about-values__featured-quote">
              <p class="about-values__quote-text">"{v.quote}"</p>
              <div class="about-values__quote-author">
                <div class="about-values__quote-avatar">{v.quoteAuthor?.charAt(0) || "?"}</div>
                <div>
                  <p class="about-values__quote-name">{v.quoteAuthor}</p>
                  {v.quoteRole && <p class="about-values__quote-role">{v.quoteRole}</p>}
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    {/* CTA */}
    {ctaText && (
      <div class="about-values__cta-wrap">
        <a href={ctaHref} class="about-values__cta">
          {ctaText}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  @import "../../styles/sections/about-values.css";
</style>
