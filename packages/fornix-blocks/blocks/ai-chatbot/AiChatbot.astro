---
---
<div class="ai-chatbot" id="ai-chatbot">
  <div class="chat-messages" id="chat-messages"></div>
  <form class="chat-form" id="chat-form">
    <input
      type="text"
      id="chat-input"
      placeholder="Ask something..."
      autocomplete="off"
    />
    <button type="submit">Send</button>
  </form>
</div>

<script>
  const form = document.getElementById("chat-form") as HTMLFormElement;
  const input = document.getElementById("chat-input") as HTMLInputElement;
  const messagesEl = document.getElementById("chat-messages") as HTMLDivElement;

  interface ChatMsg {
    role: "user" | "assistant";
    content: string;
  }

  const history: ChatMsg[] = [];

  function appendMessage(role: string, content: string): void {
    const div = document.createElement("div");
    div.className = `chat-msg chat-msg--${role}`;
    div.textContent = content;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;

    history.push({ role: "user", content: text });
    appendMessage("user", text);
    input.value = "";

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });

      const data = await res.json();
      const reply = data.response ?? "Sorry, something went wrong.";
      history.push({ role: "assistant", content: reply });
      appendMessage("assistant", reply);
    } catch {
      appendMessage("assistant", "Error: could not reach the AI service.");
    }
  });
</script>

<style>
  .ai-chatbot {
    display: flex;
    flex-direction: column;
    max-width: 600px;
    margin: 0 auto;
    border: 1px solid var(--color-accent, #e2e8f0);
    border-radius: 12px;
    overflow: hidden;
    font-family: system-ui, sans-serif;
  }
  .chat-messages {
    flex: 1;
    min-height: 300px;
    max-height: 500px;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .chat-msg {
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    max-width: 80%;
    word-wrap: break-word;
  }
  .chat-msg--user {
    align-self: flex-end;
    background: var(--color-primary, #3b82f6);
    color: white;
  }
  .chat-msg--assistant {
    align-self: flex-start;
    background: var(--color-background, #f1f5f9);
    color: var(--color-foreground, #1e293b);
  }
  .chat-form {
    display: flex;
    border-top: 1px solid var(--color-accent, #e2e8f0);
  }
  .chat-form input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: none;
    outline: none;
    font-size: 0.95rem;
  }
  .chat-form button {
    padding: 0.75rem 1.25rem;
    background: var(--color-primary, #3b82f6);
    color: white;
    border: none;
    cursor: pointer;
    font-weight: 600;
  }
</style>
