---
---
<div class="ai-search" id="ai-search">
  <form class="search-form" id="search-form">
    <input
      type="search"
      id="search-input"
      placeholder="Search..."
      autocomplete="off"
    />
    <button type="submit">Search</button>
  </form>
  <div class="search-results" id="search-results"></div>
</div>

<script>
  const form = document.getElementById("search-form") as HTMLFormElement;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const resultsEl = document.getElementById("search-results") as HTMLDivElement;

  interface SearchHit {
    id: string;
    score: number;
    metadata: Record<string, unknown>;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const query = input.value.trim();
    if (!query) return;

    resultsEl.innerHTML = "<p class='search-loading'>Searching...</p>";

    try {
      const res = await fetch("/api/search", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, topK: 5 }),
      });

      const data = (await res.json()) as { results?: SearchHit[] };
      const results = data.results ?? [];

      if (results.length === 0) {
        resultsEl.innerHTML = "<p class='search-empty'>No results found.</p>";
        return;
      }

      resultsEl.innerHTML = results
        .map(
          (r) => `
            <div class="search-hit">
              <span class="search-score">${(r.score * 100).toFixed(0)}%</span>
              <span class="search-title">${String(r.metadata.title ?? r.id)}</span>
            </div>
          `,
        )
        .join("");
    } catch {
      resultsEl.innerHTML = "<p class='search-error'>Search failed. Try again.</p>";
    }
  });
</script>

<style>
  .ai-search {
    max-width: 600px;
    margin: 0 auto;
    font-family: system-ui, sans-serif;
  }
  .search-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .search-form input {
    flex: 1;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-accent, #e2e8f0);
    border-radius: 8px;
    font-size: 0.95rem;
    outline: none;
  }
  .search-form button {
    padding: 0.6rem 1.25rem;
    background: var(--color-primary, #3b82f6);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
  }
  .search-hit {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-bottom: 1px solid var(--color-accent, #e2e8f0);
  }
  .search-score {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary, #3b82f6);
    min-width: 40px;
  }
  .search-title {
    font-weight: 500;
  }
  .search-loading,
  .search-empty,
  .search-error {
    padding: 1rem;
    text-align: center;
    color: var(--color-foreground, #64748b);
  }
</style>
