---
/**
 * Login page — email/password + GitHub OAuth.
 *
 * All text is sourced from the content collection.
 */
import { getEntry } from "astro:content";

const locale = Astro.currentLocale ?? "en";
const entry = await getEntry("sections", `${locale}/auth-login`);
const content = entry?.data ?? {
  title: "",
  emailLabel: "",
  passwordLabel: "",
  submitText: "",
  signupLink: "",
  githubText: "",
};
---

<main class="auth-page">
  <div class="auth-card">
    <h1 class="auth-card__title">{content.title}</h1>

    <form method="POST" action="/api/auth/sign-in/email" class="auth-form">
      <label class="auth-form__label">
        <span>{content.emailLabel}</span>
        <input type="email" name="email" required class="auth-form__input" />
      </label>
      <label class="auth-form__label">
        <span>{content.passwordLabel}</span>
        <input type="password" name="password" required class="auth-form__input" />
      </label>
      <button type="submit" class="auth-form__submit">{content.submitText}</button>
    </form>

    <div class="auth-divider" aria-hidden="true"></div>

    <a href="/api/auth/sign-in/social?provider=github" class="auth-social">
      {content.githubText}
    </a>

    <p class="auth-footer">
      <a href="/signup">{content.signupLink}</a>
    </p>
  </div>
</main>
