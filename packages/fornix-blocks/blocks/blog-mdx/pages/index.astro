---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog</title>
    <meta name="description" content="Read our latest blog posts." />
  </head>
  <body>
    <main class="max-w-4xl mx-auto py-12 px-4">
      <h1 class="text-4xl font-bold mb-8">Blog</h1>
      <ul class="space-y-8">
        {
          posts.map((post) => (
            <li class="border rounded-lg p-6 flex flex-col items-start hover:shadow-md transition-shadow">
              <a href={`/blog/${post.slug}/`} class="text-2xl font-semibold mb-2 hover:underline">
                {post.data.title}
              </a>
              <time datetime={post.data.pubDate.toISOString()} class="text-sm text-gray-500 mb-4">
                {post.data.pubDate.toLocaleDateString()}
              </time>
              <p class="text-gray-700">{post.data.description}</p>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
