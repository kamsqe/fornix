---
/**
 * Contact Form — full contact form with Astro Actions integration.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 * Form is submitted via Astro Actions (see contact-action.ts).
 * Requires hybrid or server rendering mode.
 */
import { getEntry } from "astro:content";

const entry = await getEntry("sections", "contact-form");
const {
  headline,
  description,
  namePlaceholder,
  emailPlaceholder,
  subjectPlaceholder,
  messagePlaceholder,
  buttonText,
  successMessage,
} = entry?.data ?? {
  headline: "",
  description: "",
  namePlaceholder: "",
  emailPlaceholder: "",
  subjectPlaceholder: "",
  messagePlaceholder: "",
  buttonText: "",
  successMessage: "",
};
---

<section class="contact-form">
  <div class="contact-form__inner">
    <div class="contact-form__header">
      <h2 class="contact-form__headline">{headline}</h2>
      {description && (
        <p class="contact-form__description">{description}</p>
      )}
    </div>
    <form
      class="contact-form__form"
      method="POST"
      data-astro-action="contact-submit"
    >
      <div class="contact-form__row">
        <input
          type="text"
          name="name"
          class="contact-form__input"
          placeholder={namePlaceholder}
          required
          aria-label={namePlaceholder}
        />
        <input
          type="email"
          name="email"
          class="contact-form__input"
          placeholder={emailPlaceholder}
          required
          aria-label={emailPlaceholder}
        />
      </div>
      <input
        type="text"
        name="subject"
        class="contact-form__input"
        placeholder={subjectPlaceholder}
        aria-label={subjectPlaceholder}
      />
      <textarea
        name="message"
        class="contact-form__textarea"
        placeholder={messagePlaceholder}
        rows="5"
        required
        aria-label={messagePlaceholder}
      ></textarea>
      <button type="submit" class="contact-form__button">
        {buttonText}
      </button>
    </form>
    <div class="contact-form__success" data-success-message hidden>
      <p>{successMessage}</p>
    </div>
  </div>
</section>

<style>
  @import "../../styles/sections/contact-form.css";
</style>
