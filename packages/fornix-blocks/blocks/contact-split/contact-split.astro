---
/**
 * Contact Split — two-column contact section: info panel + form.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 * Content is read from `src/content/sections/contact-split.json`.
 */
import { getEntry } from "astro:content";

interface ContactItem {
  icon: string;
  label: string;
  value: string;
  href?: string;
}

const entry = await getEntry("sections", "contact-split");
const {
  badge = "",
  headline = "",
  description = "",
  submitText = "Send Message",
  nameLabel = "Name",
  emailLabel = "Email",
  subjectLabel = "Subject",
  messageLabel = "Message",
} = entry?.data ?? {};
const contactItems = (entry?.data?.contactItems ?? []) as ContactItem[];
---

<section class="contact-split">
  <div class="contact-split__inner">
    <!-- Info Panel -->
    <div class="contact-split__info">
      {badge && <span class="contact-split__badge">{badge}</span>}
      <h2 class="contact-split__headline">{headline}</h2>
      {description && <p class="contact-split__description">{description}</p>}

      <div class="contact-split__items">
        {contactItems.map((item) => (
          <div class="contact-split__item">
            <span class="contact-split__item-icon">{item.icon}</span>
            <div>
              <div class="contact-split__item-label">{item.label}</div>
              {item.href ? (
                <a href={item.href} class="contact-split__item-value contact-split__item-value--link">{item.value}</a>
              ) : (
                <span class="contact-split__item-value">{item.value}</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Form Panel -->
    <div class="contact-split__form-wrap">
      <form class="contact-split__form" data-astro-reload>
        <div class="contact-split__field">
          <label class="contact-split__label" for="contact-name">{nameLabel}</label>
          <input class="contact-split__input" type="text" id="contact-name" name="name" required />
        </div>
        <div class="contact-split__field">
          <label class="contact-split__label" for="contact-email">{emailLabel}</label>
          <input class="contact-split__input" type="email" id="contact-email" name="email" required />
        </div>
        <div class="contact-split__field">
          <label class="contact-split__label" for="contact-subject">{subjectLabel}</label>
          <input class="contact-split__input" type="text" id="contact-subject" name="subject" />
        </div>
        <div class="contact-split__field">
          <label class="contact-split__label" for="contact-message">{messageLabel}</label>
          <textarea class="contact-split__textarea" id="contact-message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="contact-split__submit">{submitText}</button>
      </form>
    </div>
  </div>
</section>

<style>
  @import "../../styles/sections/contact-split.css";
</style>
