---
/**
 * CTA Banner — full-width conversion banner.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 */
import { getEntry } from "astro:content";

const locale = Astro.currentLocale ?? "en";
const entry = await getEntry("sections", `${locale}/cta-banner`);
const { headline, description, ctaText, ctaHref } = entry?.data ?? {
  headline: "",
  description: "",
  ctaText: "",
  ctaHref: "#",
};
---

<section class="cta-banner">
  <div class="cta-banner__inner">
    <div class="cta-banner__text">
      <h2 class="cta-banner__headline">{headline}</h2>
      {description && (
        <p class="cta-banner__description">{description}</p>
      )}
    </div>
    {ctaText && (
      <a href={ctaHref} class="cta-banner__cta">{ctaText}</a>
    )}
  </div>
</section>

<style>
  @import "../../styles/sections/cta-banner.css";
</style>
