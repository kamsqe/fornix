---
/**
 * CTA Newsletter — email signup section for building mailing lists.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 * Form submission is handled by Astro Actions or a custom endpoint.
 */
import { getEntry } from "astro:content";

const entry = await getEntry("sections", "cta-newsletter");
const { headline, description, placeholder, buttonText, privacyText } = entry?.data ?? {
  headline: "",
  description: "",
  placeholder: "",
  buttonText: "",
  privacyText: "",
};
---

<section class="cta-newsletter">
  <div class="cta-newsletter__inner">
    <h2 class="cta-newsletter__headline">{headline}</h2>
    {description && (
      <p class="cta-newsletter__description">{description}</p>
    )}
    <form class="cta-newsletter__form" data-astro-action="newsletter-subscribe">
      <div class="cta-newsletter__input-group">
        <input
          type="email"
          class="cta-newsletter__input"
          placeholder={placeholder}
          required
          aria-label={placeholder}
        />
        <button type="submit" class="cta-newsletter__button">
          {buttonText}
        </button>
      </div>
    </form>
    {privacyText && (
      <p class="cta-newsletter__privacy">{privacyText}</p>
    )}
  </div>
</section>

<style>
  @import "../../styles/sections/cta-newsletter.css";
</style>
