{
  "schemaVersion": 1,
  "name": "cta-stepper",
  "version": "1.0.0",
  "type": "section",
  "description": "Interactive multi-step CTA that guides users through a micro-commitment flow: choose goal → see response → take action",
  "category": "cta",
  "tags": ["cta", "interactive", "stepper", "conversion", "engagement"],
  "dependencies": {},
  "requires": [],
  "conflicts": [],
  "envVars": [],
  "variants": ["default"],
  "slots": [],
  "files": [
    {
      "source": "cta-stepper.astro",
      "destination": "src/components/sections/cta-stepper.astro"
    },
    {
      "source": "cta-stepper.css",
      "destination": "src/styles/sections/cta-stepper.css"
    }
  ],
  "ai": {
    "whenToUse": "Use as an engaging alternative to static CTA banners. Psychology-driven: small choices increase commitment. Great for SaaS trials, form completions, and high-value conversions.",
    "whenNotToUse": "Don't use if the action is simple (single button). Avoid on minimal or content-focused pages.",
    "pairsWith": ["hero-gradient", "hero-glass", "features-bento", "pricing-table"],
    "contentSlots": {
      "headline": {
        "type": "string",
        "maxLength": 80,
        "example": "What's Your Goal?"
      },
      "options": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "items": {
          "id": { "type": "string" },
          "icon": { "type": "string" },
          "label": { "type": "string" },
          "response": { "type": "string" },
          "ctaText": { "type": "string" },
          "ctaHref": { "type": "string" }
        }
      },
      "finalHeadline": {
        "type": "string",
        "example": "You're All Set"
      },
      "finalDescription": {
        "type": "string",
        "example": "Start your free trial today."
      },
      "footnote": {
        "type": "string",
        "example": "No credit card required · Cancel anytime"
      }
    }
  }
}
