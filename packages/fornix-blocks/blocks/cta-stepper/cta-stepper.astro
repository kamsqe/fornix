---
/**
 * CTA Stepper — interactive multi-step micro-commitment CTA.
 * Choose goal → see response → final action.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 * Content is read from `src/content/sections/cta-stepper.json`.
 */
import { getEntry } from "astro:content";

interface Option {
  id: string;
  icon: string;
  label: string;
  response: string;
  ctaText?: string;
  ctaHref?: string;
}

const entry = await getEntry("sections", "cta-stepper");
const {
  headline = "",
  finalHeadline = "You're All Set",
  finalDescription = "",
  footnote = "",
} = entry?.data ?? {};
const options = (entry?.data?.options ?? []) as Option[];
const optionsJson = JSON.stringify(options);
---

<section class="cta-stepper">
  <div class="cta-stepper__inner">
    <h2 class="cta-stepper__headline">{headline}</h2>

    <div class="cta-stepper__container" data-options={optionsJson}>
      <!-- Step indicators -->
      <div class="cta-stepper__indicators">
        <div class="cta-stepper__indicator cta-stepper__indicator--active" data-step="1">
          <span class="cta-stepper__dot">1</span>
          <span class="cta-stepper__dot-label">Choose</span>
        </div>
        <div class="cta-stepper__line"></div>
        <div class="cta-stepper__indicator" data-step="2">
          <span class="cta-stepper__dot">2</span>
          <span class="cta-stepper__dot-label">Confirm</span>
        </div>
        <div class="cta-stepper__line"></div>
        <div class="cta-stepper__indicator" data-step="3">
          <span class="cta-stepper__dot">3</span>
          <span class="cta-stepper__dot-label">Go</span>
        </div>
      </div>

      <!-- Step 1: Choose goal -->
      <div class="cta-stepper__step cta-stepper__step-1">
        <div class="cta-stepper__options">
          {options.map((opt) => (
            <button class="cta-stepper__option" data-option={opt.id}>
              <span class="cta-stepper__option-icon">{opt.icon}</span>
              <span class="cta-stepper__option-label">{opt.label}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2: Response -->
      <div class="cta-stepper__step cta-stepper__step-2 cta-stepper__step--hidden">
        <div class="cta-stepper__response">
          <span class="cta-stepper__response-icon">🚀</span>
          <p class="cta-stepper__response-text">...</p>
          <button class="cta-stepper__continue">Continue →</button>
        </div>
      </div>

      <!-- Step 3: Final CTA -->
      <div class="cta-stepper__step cta-stepper__step-3 cta-stepper__step--hidden">
        <div class="cta-stepper__final">
          <div class="cta-stepper__final-icon">✨</div>
          <h3 class="cta-stepper__final-headline">{finalHeadline}</h3>
          {finalDescription && <p class="cta-stepper__final-desc">{finalDescription}</p>}
          <a href="#" class="cta-stepper__final-cta">Get Started</a>
          {footnote && <p class="cta-stepper__footnote">{footnote}</p>}
          <button class="cta-stepper__restart">← Change goal</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initCtaStepper() {
    const container = document.querySelector(".cta-stepper__container") as HTMLElement;
    if (!container) return;

    const options = JSON.parse(container.dataset.options || "[]");
    let selected: any = null;

    const step1 = container.querySelector(".cta-stepper__step-1");
    const step2 = container.querySelector(".cta-stepper__step-2");
    const step3 = container.querySelector(".cta-stepper__step-3");
    const indicators = container.querySelectorAll(".cta-stepper__indicator");
    const lines = container.querySelectorAll(".cta-stepper__line");

    function updateIndicators(current: number) {
      indicators.forEach((ind, i) => {
        const s = i + 1;
        ind.classList.toggle("cta-stepper__indicator--active", s <= current);
        ind.classList.toggle("cta-stepper__indicator--done", s < current);
      });
      lines.forEach((line, i) => {
        line.classList.toggle("cta-stepper__line--active", i < current - 1);
      });
    }

    function goTo(step: number) {
      step1?.classList.toggle("cta-stepper__step--hidden", step !== 1);
      step2?.classList.toggle("cta-stepper__step--hidden", step !== 2);
      step3?.classList.toggle("cta-stepper__step--hidden", step !== 3);
      updateIndicators(step);
    }

    // Step 1: option selection
    container.querySelectorAll(".cta-stepper__option").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = (btn as HTMLElement).dataset.option;
        selected = options.find((o: any) => o.id === id);
        if (!selected) return;

        // Update step 2
        const icon = step2?.querySelector(".cta-stepper__response-icon");
        const text = step2?.querySelector(".cta-stepper__response-text");
        if (icon) icon.textContent = selected.icon;
        if (text) text.textContent = selected.response;

        setTimeout(() => goTo(2), 200);
      });
    });

    // Step 2: continue
    container.querySelector(".cta-stepper__continue")?.addEventListener("click", () => {
      // Update step 3 CTA
      const cta = step3?.querySelector(".cta-stepper__final-cta") as HTMLAnchorElement;
      if (cta && selected) {
        cta.textContent = selected.ctaText || "Get Started";
        cta.href = selected.ctaHref || "#";
      }
      goTo(3);
    });

    // Restart
    container.querySelector(".cta-stepper__restart")?.addEventListener("click", () => {
      selected = null;
      goTo(1);
    });

    goTo(1);
  }

  initCtaStepper();
  document.addEventListener("astro:after-swap", initCtaStepper);
</script>

<style>
  @import "../../styles/sections/cta-stepper.css";
</style>
