{
  "schemaVersion": 1,
  "name": "docs-collection",
  "version": "1.0.0",
  "type": "feature",
  "description": "Documentation feature with MDX processing and a generated sidebar navigation.",
  "category": "docs",
  "tags": ["docs", "mdx", "content", "navigation"],
  "dependencies": {
    "@astrojs/mdx": "^4.0.0"
  },
  "requires": [],
  "conflicts": [],
  "envVars": [],
  "variants": ["default"],
  "slots": [],
  "files": [
    {
      "source": "schema.ts",
      "destination": "src/content/docs-schema.ts"
    },
    {
      "source": "pages/[...slug].astro",
      "destination": "src/pages/docs/[...slug].astro"
    }
  ],
  "collections": [
    {
      "name": "docs",
      "type": "content",
      "schemaSource": "./docs-schema.ts"
    }
  ],
  "ai": {
    "whenToUse": "User wants a documentation site powered by Markdown or MDX files with sidebar navigation.",
    "whenNotToUse": "User wants a blog or headless CMS.",
    "pairsWith": ["header-sticky"]
  }
}
