---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: doc,
  }));
}

const doc = Astro.props;
const { Content } = await doc.render();

const allDocs = await getCollection("docs");
const sidebar = allDocs.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) {
    return a.data.order - b.data.order;
  }
  return a.data.title.localeCompare(b.data.title);
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{doc.data.title}</title>
    <meta name="description" content={doc.data.description} />
  </head>
  <body class="flex flex-col md:flex-row min-h-screen">
    <aside class="w-full md:w-64 border-r p-6 bg-gray-50 flex-shrink-0">
      <nav aria-label="Documentation Navigation">
        <h2 class="text-xl font-bold mb-4">Documentation</h2>
        <ul class="space-y-2">
          {
            sidebar.map((item) => (
              <li>
                <a
                  href={`/docs/${item.slug}/`}
                  class={`block hover:text-blue-600 ${
                    Astro.url.pathname === `/docs/${item.slug}/`
                      ? "text-blue-600 font-semibold"
                      : "text-gray-700"
                  }`}
                >
                  {item.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
    <main class="flex-grow p-6 md:p-12">
      <article class="max-w-3xl prose">
        <h1 class="text-4xl font-extrabold mb-4">{doc.data.title}</h1>
        <Content />
      </article>
    </main>
  </body>
</html>
