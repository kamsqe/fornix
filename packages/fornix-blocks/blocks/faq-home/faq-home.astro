---
/**
 * FAQ Home — lightweight landing page FAQ accordion.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 * Content is read from `src/content/sections/faq-home.json`.
 */
import { getEntry } from "astro:content";

interface FaqItem {
  question: string;
  answer: string;
}

const locale = Astro.currentLocale ?? "en";
const entry = await getEntry("sections", `${locale}/faq-home`);
const { badge = "", headline = "" } = entry?.data ?? {};
const items = (entry?.data?.items ?? []) as FaqItem[];
---

<section class="faq-home">
  <div class="faq-home__inner">
    <!-- Header -->
    <div class="faq-home__header">
      {badge && (
        <span class="faq-home__badge">
          <span class="faq-home__badge-dot"></span>
          {badge}
        </span>
      )}
      <h2 class="faq-home__headline">{headline}</h2>
    </div>

    <!-- Questions -->
    <div class="faq-home__list">
      {items.map((item, i) => (
        <div class="faq-home__item" style={`animation-delay: ${i * 80}ms`}>
          <button
            class="faq-home__trigger"
            aria-expanded="false"
          >
            <span class="faq-home__question">{item.question}</span>
            <svg class="faq-home__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-home__answer">
            <p class="faq-home__answer-text">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initFaqHome() {
    const items = document.querySelectorAll(".faq-home__item");

    items.forEach((item) => {
      const trigger = item.querySelector(".faq-home__trigger");
      if (!trigger) return;

      trigger.addEventListener("click", () => {
        const isOpen = item.classList.contains("faq-home__item--open");

        // Close all others
        items.forEach((other) => {
          if (other !== item) {
            other.classList.remove("faq-home__item--open");
            other.querySelector(".faq-home__trigger")?.setAttribute("aria-expanded", "false");
          }
        });

        // Toggle this
        item.classList.toggle("faq-home__item--open", !isOpen);
        trigger.setAttribute("aria-expanded", String(!isOpen));
      });
    });
  }

  initFaqHome();
  document.addEventListener("astro:after-swap", initFaqHome);
</script>

<style>
  @import "../../styles/sections/faq-home.css";
</style>
