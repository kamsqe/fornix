---
/**
 * Features Bento — mixed-size feature grid. Each feature can be `default`
 * (single column) or `large` (spans two columns on ≥768px viewports).
 *
 * Composes: Section, Container, Headline, Eyebrow, Card, Icon.
 */
import { getEntry } from "astro:content";
import Section from "../primitives/Section.astro";
import Container from "../primitives/Container.astro";
import Headline from "../primitives/Headline.astro";
import Eyebrow from "../primitives/Eyebrow.astro";
import Card from "../primitives/Card.astro";
import Icon from "../primitives/Icon.astro";
import { site } from "../../site.config";

type IconName =
  | "check" | "arrow-right" | "chevron-down" | "chevron-up"
  | "external-link" | "menu" | "x" | "play" | "star"
  | "mail" | "phone" | "map-pin";

interface BentoItem {
  icon: IconName;
  title: string;
  description: string;
  span?: "default" | "large";
}

const locale = Astro.currentLocale ?? site.locale.default;
const entry = await getEntry("sections", `${locale}/features-bento`);
const data = (entry?.data ?? {}) as {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  features?: BentoItem[];
};

const eyebrow = data.eyebrow ?? "";
const headline = data.headline ?? "";
const subheadline = data.subheadline ?? "";
const features = (data.features ?? []) as BentoItem[];
---

<Section variant="alt">
  <Container size="wide">
    <header class="fnx-bento__header">
      {eyebrow && <Eyebrow align="center">{eyebrow}</Eyebrow>}
      {headline && (
        <Headline level={2} align="center" measure="comfortable">
          {headline}
        </Headline>
      )}
      {subheadline && <p class="fnx-bento__sub">{subheadline}</p>}
    </header>

    <div class="fnx-bento__grid">
      {features.map((feature) => (
        <Card
          variant="bordered"
          class:list={[
            "fnx-bento__card",
            feature.span === "large" && "fnx-bento__card--large",
          ]}
        >
          <div class="fnx-bento__icon-wrap">
            <Icon name={feature.icon} size="1.25rem" />
          </div>
          <h3 class="fnx-bento__title">{feature.title}</h3>
          <p class="fnx-bento__desc">{feature.description}</p>
        </Card>
      ))}
    </div>
  </Container>
</Section>

<style>
  .fnx-bento__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    margin-bottom: 3rem;
  }

  .fnx-bento__sub {
    margin: 0;
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }

  .fnx-bento__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .fnx-bento__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .fnx-bento__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    border-radius: var(--radius-md);
  }

  .fnx-bento__title {
    margin: 0;
    font-family: var(--font-headline);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .fnx-bento__desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }

  @media (min-width: 768px) {
    .fnx-bento__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
    .fnx-bento__card {
      grid-column: span 2;
    }
    .fnx-bento__card--large {
      grid-column: span 4;
    }
  }

  @media (min-width: 1024px) {
    .fnx-bento__grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .fnx-bento__card {
      grid-column: span 2;
    }
    .fnx-bento__card--large {
      grid-column: span 3;
    }
  }
</style>
