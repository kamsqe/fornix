{
  "schemaVersion": 1,
  "name": "footer-rich",
  "version": "1.0.0",
  "type": "section",
  "description": "Multi-column footer with navigation links, social icons, newsletter signup, and legal text",
  "category": "footer",
  "tags": ["footer", "navigation", "social", "newsletter", "legal"],
  "dependencies": {},
  "requires": [],
  "conflicts": [],
  "envVars": [],
  "variants": ["default", "dark", "centered"],
  "slots": ["newsletter-form"],
  "files": [
    {
      "source": "footer-rich.astro",
      "destination": "src/components/sections/footer-rich.astro"
    },
    {
      "source": "footer-rich.css",
      "destination": "src/styles/sections/footer-rich.css"
    }
  ],
  "ai": {
    "whenToUse": "Use as the primary footer on marketing sites, SaaS pages, and agency sites that need organized navigation, social links, and legal information. Best when there are multiple page categories to link to.",
    "whenNotToUse": "Don't use on single-page apps or minimal landing pages where footer-minimal is more appropriate. Avoid for documentation sites that use sidebar navigation.",
    "pairsWith": ["hero-gradient", "hero-split", "pricing-table", "cta-banner"],
    "contentSlots": {
      "brandName": {
        "type": "string",
        "description": "Company or brand name in the footer",
        "maxLength": 40,
        "example": "Fornix"
      },
      "brandDescription": {
        "type": "string",
        "description": "Short brand description or tagline",
        "maxLength": 200,
        "example": "The CLI-first Astro framework for building modern websites."
      },
      "columns": {
        "type": "array",
        "description": "Array of link column objects for footer navigation",
        "minItems": 2,
        "maxItems": 4,
        "items": {
          "title": { "type": "string" },
          "links": { "type": "array" }
        },
        "example": [
          {
            "title": "Product",
            "links": [
              { "label": "Features", "href": "#features" },
              { "label": "Pricing", "href": "#pricing" },
              { "label": "Changelog", "href": "#changelog" }
            ]
          },
          {
            "title": "Company",
            "links": [
              { "label": "About", "href": "#about" },
              { "label": "Blog", "href": "#blog" },
              { "label": "Careers", "href": "#careers" }
            ]
          },
          {
            "title": "Legal",
            "links": [
              { "label": "Privacy", "href": "#privacy" },
              { "label": "Terms", "href": "#terms" }
            ]
          }
        ]
      },
      "copyright": {
        "type": "string",
        "description": "Copyright notice text",
        "maxLength": 100,
        "example": "© 2026 Fornix. All rights reserved."
      }
    }
  }
}
