---
/**
 * Footer Rich — multi-column footer with navigation and brand info.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 */
import { getEntry } from "astro:content";

const entry = await getEntry("sections", "footer-rich");
const { brandName, brandDescription, columns, copyright } = entry?.data ?? {
  brandName: "",
  brandDescription: "",
  columns: [],
  copyright: "",
};
---

<footer class="footer-rich">
  <div class="footer-rich__inner">
    <div class="footer-rich__brand">
      <span class="footer-rich__brand-name">{brandName}</span>
      {brandDescription && (
        <p class="footer-rich__brand-description">{brandDescription}</p>
      )}
    </div>
    <div class="footer-rich__columns">
      {(columns as Array<{
        title: string;
        links: Array<{ label: string; href: string }>;
      }>).map((column) => (
        <div class="footer-rich__column">
          <h4 class="footer-rich__column-title">{column.title}</h4>
          <ul class="footer-rich__links">
            {column.links.map((link: { label: string; href: string }) => (
              <li>
                <a href={link.href} class="footer-rich__link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  {copyright && (
    <div class="footer-rich__bottom">
      <p class="footer-rich__copyright">{copyright}</p>
    </div>
  )}
</footer>

<style>
  @import "../../styles/sections/footer-rich.css";
</style>
