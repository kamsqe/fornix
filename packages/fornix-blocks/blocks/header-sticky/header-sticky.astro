---
/**
 * Header Sticky — fixed navigation header that stays at the top on scroll.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 */
import { getEntry } from "astro:content";

interface NavLink {
  label: string;
  href: string;
}

const locale = Astro.currentLocale ?? "en";
const entry = await getEntry("sections", `${locale}/header-sticky`);
const { brandName, ctaText, ctaHref } = entry?.data ?? {
  brandName: "",
  ctaText: "",
  ctaHref: "#",
};
const navLinks = (entry?.data?.navLinks ?? []) as NavLink[];
---

<header class="header-sticky">
  <div class="header-sticky__inner">
    <a href="/" class="header-sticky__brand">{brandName}</a>
    <nav class="header-sticky__nav" aria-label="primary">
      <ul class="header-sticky__links">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="header-sticky__link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-sticky__actions">
      <slot name="actions">
        {ctaText && (
          <a href={ctaHref} class="header-sticky__cta">{ctaText}</a>
        )}
      </slot>
    </div>
    <button class="header-sticky__mobile-toggle" aria-label="menu" aria-expanded="false">
      <span class="header-sticky__hamburger"></span>
    </button>
  </div>
</header>

<style>
  @import "../../styles/sections/header-sticky.css";
</style>
