---
/**
 * Header Transparent — overlay header that blends with hero sections.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 */
import { getEntry } from "astro:content";

const entry = await getEntry("sections", "header-transparent");
const { brandName, navLinks, ctaText, ctaHref } = entry?.data ?? {
  brandName: "",
  navLinks: [],
  ctaText: "",
  ctaHref: "#",
};
---

<header class="header-transparent">
  <div class="header-transparent__inner">
    <a href="/" class="header-transparent__brand">{brandName}</a>
    <nav class="header-transparent__nav" aria-label="primary">
      <ul class="header-transparent__links">
        {(navLinks as Array<{ label: string; href: string }>).map((link) => (
          <li>
            <a href={link.href} class="header-transparent__link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-transparent__actions">
      <slot name="actions">
        {ctaText && (
          <a href={ctaHref} class="header-transparent__cta">{ctaText}</a>
        )}
      </slot>
    </div>
    <button class="header-transparent__mobile-toggle" aria-label="menu" aria-expanded="false">
      <span class="header-transparent__hamburger"></span>
    </button>
  </div>
</header>

<style>
  @import "../../styles/sections/header-transparent.css";
</style>
