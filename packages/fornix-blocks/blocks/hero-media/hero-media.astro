---
/**
 * Hero Media — split-layout hero. Text on one side, media (illustration/photo)
 * on the other. Ships with a default palette-aware SVG illustration so a
 * fresh scaffold renders intentionally rather than as a TODO.
 *
 * Composes: Section, Container, Headline, Eyebrow, Button.
 * Reads from site.config: tagline (headline fallback), ctaPrimary, ctaSecondary.
 *
 * Media placement: `right` (default) or `left`. Stacks vertically below 768px
 * regardless — media goes below text on mobile so the headline lands first.
 */
import { getEntry } from "astro:content";
import Section from "../primitives/Section.astro";
import Container from "../primitives/Container.astro";
import Headline from "../primitives/Headline.astro";
import Eyebrow from "../primitives/Eyebrow.astro";
import Button from "../primitives/Button.astro";
import { site } from "../../site.config";

const locale = Astro.currentLocale ?? site.locale.default;
const entry = await getEntry("sections", `${locale}/hero-media`);
const data = (entry?.data ?? {}) as {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  mediaSrc?: string;
  mediaAlt?: string;
  mediaPlacement?: "right" | "left";
};

const eyebrow = data.eyebrow ?? "";
const headline = data.headline ?? site.tagline ?? "Build something great.";
const subheadline = data.subheadline ?? "";
const primaryText = data.primaryCtaText ?? site.ctaPrimary?.text ?? "Get started";
const primaryHref = data.primaryCtaHref ?? site.ctaPrimary?.href ?? "/";
const secondaryText = data.secondaryCtaText ?? site.ctaSecondary?.text;
const secondaryHref = data.secondaryCtaHref ?? site.ctaSecondary?.href;

const mediaSrc = data.mediaSrc ?? "/illustrations/hero-default.svg";
const mediaAlt = data.mediaAlt ?? "";
const mediaPlacement = data.mediaPlacement ?? "right";
---

<Section id="hero" density="spacious">
  <Container size="wide">
    <div class:list={["fnx-hero-media", `fnx-hero-media--${mediaPlacement}`]}>
      <div class="fnx-hero-media__text">
        {eyebrow && <Eyebrow align="left">{eyebrow}</Eyebrow>}
        <Headline level={1} align="left" measure="comfortable">
          {headline}
        </Headline>
        {subheadline && <p class="fnx-hero-media__sub">{subheadline}</p>}
        <div class="fnx-hero-media__actions">
          <Button href={primaryHref} variant="primary" size="lg">
            {primaryText}
          </Button>
          {secondaryText && (
            <Button href={secondaryHref ?? "#"} variant="secondary" size="lg">
              {secondaryText}
            </Button>
          )}
        </div>
      </div>

      <div class="fnx-hero-media__media">
        <img
          src={mediaSrc}
          alt={mediaAlt}
          class="fnx-hero-media__img"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </Container>
</Section>

<style>
  .fnx-hero-media {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .fnx-hero-media__text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .fnx-hero-media__sub {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-foreground) 75%, transparent);
    margin: 0;
    max-width: 44ch;
    text-wrap: pretty;
  }

  .fnx-hero-media__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .fnx-hero-media__media {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fnx-hero-media__img {
    width: 100%;
    max-width: 36rem;
    height: auto;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 768px) {
    .fnx-hero-media {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .fnx-hero-media--left .fnx-hero-media__text {
      order: 2;
    }
    .fnx-hero-media--left .fnx-hero-media__media {
      order: 1;
    }
  }
</style>
