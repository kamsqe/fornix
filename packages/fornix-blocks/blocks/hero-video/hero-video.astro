---
/**
 * Hero Video — full-width hero with background video.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 */
import { getEntry } from "astro:content";

const entry = await getEntry("sections", "hero-video");
const { headline, subheadline, ctaText, ctaHref, videoUrl, posterUrl } = entry?.data ?? {
  headline: "",
  subheadline: "",
  ctaText: "",
  ctaHref: "#",
  videoUrl: "",
  posterUrl: "",
};
---

<section class="hero-video">
  {videoUrl && (
    <video
      class="hero-video__bg"
      autoplay
      muted
      loop
      playsinline
      poster={posterUrl}
    >
      <source src={videoUrl} type="video/mp4" />
    </video>
  )}
  <div class="hero-video__overlay"></div>
  <div class="hero-video__content">
    <h1 class="hero-video__headline">{headline}</h1>
    {subheadline && (
      <p class="hero-video__subheadline">{subheadline}</p>
    )}
    {ctaText && (
      <a href={ctaHref} class="hero-video__cta">{ctaText}</a>
    )}
  </div>
</section>

<style>
  @import "../../styles/sections/hero-video.css";
</style>
