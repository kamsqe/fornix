---
import { getEntry } from "astro:content";

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect("/login");
}

const { data } = await getEntry("layouts", "layout-dashboard");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
  </head>
  <body class="min-h-screen flex bg-gray-50 font-sans text-gray-900">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col hidden md:flex">
      <div class="h-16 flex items-center px-6 border-b border-gray-100 font-bold text-lg">
        App
      </div>
      <nav class="flex-1 px-4 py-4 space-y-1">
        {data.sidebarLinks.map((link: { href: string; label: string; icon?: string }) => (
          <a href={link.href} class="flex items-center px-2 py-2 text-sm font-medium rounded-md text-gray-600 hover:bg-gray-50 hover:text-gray-900">
            {link.label}
          </a>
        ))}
      </nav>
      <div class="p-4 border-t border-gray-200">
        <form action="/api/auth/signout" method="post">
           <button type="submit" class="w-full text-left px-2 py-2 text-sm font-medium text-red-600 hover:bg-red-50 rounded-md">
             {data.logoutText}
           </button>
        </form>
      </div>
    </aside>

    <!-- Main Content Shell -->
    <div class="flex-1 flex flex-col overflow-hidden">
      <!-- Top nav (mobile toggle + profile) -->
      <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-4 sm:px-6">
        <div class="md:hidden font-bold">App</div>
        <div class="ml-auto flex items-center">
            <span class="text-sm font-medium text-gray-700">{session?.user?.email || 'User'}</span>
        </div>
      </header>
      
      <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 p-6">
        <slot />
      </main>
    </div>
  </body>
</html>
