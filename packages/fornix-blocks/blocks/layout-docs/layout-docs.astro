---
import { getEntry } from "astro:content";

const { data } = await getEntry("layouts", "layout-docs");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.headerTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col font-sans text-gray-900 bg-white">
    <header class="border-b border-gray-200 py-3 px-6 flex items-center bg-gray-50 z-10 sticky top-0">
      <div class="font-bold text-lg tracking-tight">{data.headerTitle}</div>
    </header>

    <div class="flex-1 flex flex-col md:flex-row max-w-7xl w-full mx-auto">
      <aside class="w-full md:w-64 border-r border-gray-100 p-6 overflow-y-auto">
        <slot name="sidebar" />
      </aside>

      <main class="flex-1 p-6 md:p-12 overflow-y-auto">
        <slot />
      </main>
    </div>

    <footer class="border-t border-gray-100 py-6 text-center text-gray-500 text-sm mt-auto">
      <p>{data.footerText}</p>
    </footer>
  </body>
</html>
