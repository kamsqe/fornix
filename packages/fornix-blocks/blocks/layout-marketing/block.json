{
  "$schema": "../../node_modules/fornix-registry/schema/block-manifest.json",
  "schemaVersion": 1,
  "name": "layout-marketing",
  "version": "1.0.0",
  "type": "layout",
  "description": "A standard marketing site layout shell with header navigation and footer.",
  "category": "marketing",
  "tags": ["layout", "marketing", "shell", "navigation"],
  "dependencies": {},
  "requires": [],
  "conflicts": [],
  "envVars": [],
  "variants": ["default"],
  "slots": ["main"],
  "files": [
    {
      "source": "layout-marketing.astro",
      "destination": "src/layouts/layout-marketing.astro"
    },
    {
      "source": "default-content.json",
      "destination": "src/content/layouts/layout-marketing.json"
    }
  ],
  "ai": {
    "whenToUse": "The primary shell for public-facing marketing pages, landing pages, and content sites.",
    "whenNotToUse": "Inside logged-in app dashboards or technical documentation portals.",
    "pairsWith": ["hero-gradient", "footer-minimal", "cta-simple"],
    "contentSlots": {
      "headerLinks": {
        "type": "array",
        "description": "Navigation links shown in the top header",
        "items": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "href": { "type": "string" }
          },
          "required": ["label", "href"]
        },
        "minItems": 1
      },
      "footerText": {
        "type": "string",
        "description": "Copyright or small text shown in the bottom footer"
      }
    }
  }
}
