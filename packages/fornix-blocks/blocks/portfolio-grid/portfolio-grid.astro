---
/**
 * Portfolio Grid — filterable project showcase with category tabs.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 * Content is read from `src/content/sections/portfolio-grid.json`.
 */
import { getEntry } from "astro:content";

interface Project {
  title: string;
  category: string;
  description?: string;
  image?: string;
  href?: string;
}

const locale = Astro.currentLocale ?? "en";
const entry = await getEntry("sections", `${locale}/portfolio-grid`);
const {
  badge = "",
  headline = "",
  subheadline = "",
} = entry?.data ?? {};
const categories = (entry?.data?.categories ?? ["All"]) as string[];
const projects = (entry?.data?.projects ?? []) as Project[];
---

<section class="portfolio-grid">
  <div class="portfolio-grid__inner">
    <!-- Header -->
    <div class="portfolio-grid__header">
      {badge && <span class="portfolio-grid__badge">{badge}</span>}
      <h2 class="portfolio-grid__headline">{headline}</h2>
      {subheadline && <p class="portfolio-grid__subheadline">{subheadline}</p>}
    </div>

    <!-- Filter Tabs -->
    {categories.length > 1 && (
      <div class="portfolio-grid__filters" role="tablist">
        {categories.map((cat, i) => (
          <button
            class:list={["portfolio-grid__filter", i === 0 && "portfolio-grid__filter--active"]}
            data-filter={cat}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
          >
            {cat}
          </button>
        ))}
      </div>
    )}

    <!-- Projects Grid -->
    <div class="portfolio-grid__grid">
      {projects.map((project) => (
        <a
          href={project.href || "#"}
          class="portfolio-grid__card"
          data-category={project.category}
        >
          <div class="portfolio-grid__card-visual">
            {project.image ? (
              <img src={project.image} alt={project.title} class="portfolio-grid__img" loading="lazy" />
            ) : (
              <div class="portfolio-grid__placeholder">
                <span>{project.title.charAt(0)}</span>
              </div>
            )}
          </div>
          <div class="portfolio-grid__card-overlay">
            <span class="portfolio-grid__card-category">{project.category}</span>
            <h3 class="portfolio-grid__card-title">{project.title}</h3>
            {project.description && (
              <p class="portfolio-grid__card-desc">{project.description}</p>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  function initPortfolioFilter() {
    const section = document.querySelector(".portfolio-grid");
    if (!section) return;

    const filters = section.querySelectorAll(".portfolio-grid__filter");
    const cards = section.querySelectorAll<HTMLElement>(".portfolio-grid__card");

    filters.forEach((btn) => {
      btn.addEventListener("click", () => {
        const category = (btn as HTMLElement).dataset.filter || "All";

        // Update active state
        filters.forEach((f) => {
          f.classList.remove("portfolio-grid__filter--active");
          f.setAttribute("aria-selected", "false");
        });
        btn.classList.add("portfolio-grid__filter--active");
        btn.setAttribute("aria-selected", "true");

        // Filter cards
        cards.forEach((card) => {
          const match = category === "All" || card.dataset.category === category;
          card.style.display = match ? "" : "none";
          card.style.opacity = match ? "1" : "0";
        });
      });
    });
  }

  initPortfolioFilter();
  document.addEventListener("astro:after-swap", initPortfolioFilter);
</script>

<style>
  @import "../../styles/sections/portfolio-grid.css";
</style>
