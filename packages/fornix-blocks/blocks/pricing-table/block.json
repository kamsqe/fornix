{
  "schemaVersion": 1,
  "name": "pricing-table",
  "version": "2.0.0",
  "type": "section",
  "description": "Side-by-side pricing plans with one highlighted as Most Popular. Composes Card-featured + Icon + Button. 2–4 plans supported.",
  "category": "pricing",
  "tags": ["pricing", "plans", "v0.3"],
  "dependencies": {},
  "requires": [],
  "conflicts": ["pricing-comparison", "pricing-toggle"],
  "envVars": [],
  "variants": ["default"],
  "slots": [],
  "files": [
    {
      "source": "pricing-table.astro",
      "destination": "src/components/sections/pricing-table.astro"
    }
  ],
  "ai": {
    "whenToUse": "Use to show 2–4 pricing tiers side-by-side with a 'Most Popular' middle card. Best for SaaS, agency packages, gym memberships, course tiers. Pricing should be honest and realistic — defaults ship as $19 / $49 / $199 not $9 / $29 / $99.",
    "whenNotToUse": "Don't use for monthly/annual toggles (use `pricing-toggle` once we add it). Don't use for feature-comparison matrices (different block, not in v0.3).",
    "pairsWith": ["features-grid", "faq", "cta-strip"],
    "contentSlots": {
      "eyebrow": {
        "type": "string",
        "description": "Optional pre-headline label.",
        "maxLength": 40,
        "example": "Pricing"
      },
      "headline": {
        "type": "string",
        "description": "Section headline.",
        "maxLength": 80,
        "example": "Simple, honest pricing"
      },
      "subheadline": {
        "type": "string",
        "description": "One-line elaboration.",
        "maxLength": 200,
        "example": "No hidden fees. No per-seat pricing surprises. Upgrade or cancel any time."
      },
      "plans": {
        "type": "array",
        "description": "Pricing tiers. Mark one with `highlighted: true` to feature it.",
        "minItems": 2,
        "maxItems": 4,
        "items": {
          "name": { "type": "string" },
          "price": { "type": "string" },
          "period": { "type": "string" },
          "description": { "type": "string" },
          "features": { "type": "array" },
          "ctaText": { "type": "string" },
          "ctaHref": { "type": "string" },
          "highlighted": { "type": "boolean" }
        },
        "example": [
          {
            "name": "Solo",
            "price": "$19",
            "period": "/mo",
            "description": "Solo builders and side-project hackers.",
            "features": ["3 projects", "10GB asset bandwidth", "Community support"],
            "ctaText": "Start free",
            "ctaHref": "/signup?plan=solo"
          }
        ]
      },
      "popularBadge": {
        "type": "string",
        "description": "Label shown on the highlighted plan card.",
        "maxLength": 24,
        "example": "Most Popular"
      }
    }
  }
}
