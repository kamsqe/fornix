---
/**
 * Pricing Table — 2–4 plans side-by-side, one highlighted.
 *
 * Composes: Section, Container, Headline, Eyebrow, Card, Button, Icon.
 * Reads no site.config — purely content-driven via the `plans` slot.
 */
import { getEntry } from "astro:content";
import Section from "../primitives/Section.astro";
import Container from "../primitives/Container.astro";
import Headline from "../primitives/Headline.astro";
import Eyebrow from "../primitives/Eyebrow.astro";
import Card from "../primitives/Card.astro";
import Button from "../primitives/Button.astro";
import Icon from "../primitives/Icon.astro";
import { site } from "../../site.config";

interface Plan {
  name: string;
  price: string;
  period?: string;
  description?: string;
  features: string[];
  ctaText?: string;
  ctaHref?: string;
  highlighted?: boolean;
}

const locale = Astro.currentLocale ?? site.locale.default;
const entry = await getEntry("sections", `${locale}/pricing-table`);
const data = (entry?.data ?? {}) as {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  plans?: Plan[];
  popularBadge?: string;
};

const eyebrow = data.eyebrow ?? "";
const headline = data.headline ?? "";
const subheadline = data.subheadline ?? "";
const plans = (data.plans ?? []) as Plan[];
const popularBadge = data.popularBadge ?? "Most Popular";
---

<Section id="pricing">
  <Container size="wide">
    <header class="fnx-pricing__header">
      {eyebrow && <Eyebrow align="center">{eyebrow}</Eyebrow>}
      {headline && (
        <Headline level={2} align="center" measure="comfortable">
          {headline}
        </Headline>
      )}
      {subheadline && <p class="fnx-pricing__sub">{subheadline}</p>}
    </header>

    <div class:list={["fnx-pricing__grid", `fnx-pricing__grid--${plans.length}`]}>
      {plans.map((plan) => (
        <Card
          variant={plan.highlighted ? "featured" : "bordered"}
          class="fnx-pricing__card"
        >
          {plan.highlighted && (
            <span class="fnx-pricing__badge">{popularBadge}</span>
          )}
          <h3 class="fnx-pricing__plan-name">{plan.name}</h3>
          <div class="fnx-pricing__price-row">
            <span class="fnx-pricing__price">{plan.price}</span>
            {plan.period && (
              <span class="fnx-pricing__period">{plan.period}</span>
            )}
          </div>
          {plan.description && (
            <p class="fnx-pricing__desc">{plan.description}</p>
          )}
          <ul class="fnx-pricing__features">
            {plan.features.map((feature) => (
              <li class="fnx-pricing__feature">
                <span class="fnx-pricing__check" aria-hidden="true">
                  <Icon name="check" size="1rem" />
                </span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <Button
            href={plan.ctaHref ?? "/"}
            variant={plan.highlighted ? "primary" : "secondary"}
            size="default"
            class="fnx-pricing__cta"
          >
            {plan.ctaText ?? "Get started"}
          </Button>
        </Card>
      ))}
    </div>
  </Container>
</Section>

<style>
  .fnx-pricing__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    margin-bottom: 3rem;
  }

  .fnx-pricing__sub {
    margin: 0;
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    text-wrap: pretty;
  }

  .fnx-pricing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .fnx-pricing__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .fnx-pricing__badge {
    position: absolute;
    top: -0.875rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.25rem 0.75rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--radius-full);
  }

  .fnx-pricing__plan-name {
    margin: 0;
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .fnx-pricing__price-row {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .fnx-pricing__price {
    font-family: var(--font-headline);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-foreground);
  }

  .fnx-pricing__period {
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
  }

  .fnx-pricing__desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }

  .fnx-pricing__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }

  .fnx-pricing__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-foreground) 85%, transparent);
  }

  .fnx-pricing__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.05em;
    background: color-mix(in srgb, var(--color-primary) 16%, transparent);
    color: var(--color-primary);
    border-radius: var(--radius-full);
  }

  .fnx-pricing__cta {
    margin-top: 0.5rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .fnx-pricing__grid--2 {
      grid-template-columns: repeat(2, 1fr);
      max-width: 48rem;
      margin-inline: auto;
    }
    .fnx-pricing__grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .fnx-pricing__grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .fnx-pricing__grid--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
