---
/**
 * Pricing Toggle — pricing cards with monthly/annual toggle.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 * Content is read from `src/content/sections/pricing-toggle.json`.
 */
import { getEntry } from "astro:content";

interface Plan {
  name: string;
  monthlyPrice: string;
  annualPrice: string;
  description?: string;
  features: string[];
  ctaText?: string;
  ctaHref?: string;
  highlighted?: boolean;
}

const locale = Astro.currentLocale ?? "en";
const entry = await getEntry("sections", `${locale}/pricing-toggle`);
const {
  badge = "",
  headline = "",
  subheadline = "",
  monthlyLabel = "Monthly",
  annualLabel = "Annual",
  annualSavings = "Save 20%",
  popularBadge = "Most Popular",
  toggleAriaLabel = "Toggle annual pricing",
} = entry?.data ?? {};
const plans = (entry?.data?.plans ?? []) as Plan[];
const plansJson = JSON.stringify(plans.map(p => ({ monthly: p.monthlyPrice, annual: p.annualPrice })));
---

<section class="pricing-toggle">
  <div class="pricing-toggle__inner">
    <!-- Header -->
    <div class="pricing-toggle__header">
      {badge && <span class="pricing-toggle__badge">{badge}</span>}
      <h2 class="pricing-toggle__headline">{headline}</h2>
      {subheadline && <p class="pricing-toggle__subheadline">{subheadline}</p>}

      <!-- Toggle Switch -->
      <div class="pricing-toggle__switch-wrap">
        <span class="pricing-toggle__switch-label pricing-toggle__switch-label--active" data-period="monthly">{monthlyLabel}</span>
        <button
          class="pricing-toggle__switch"
          role="switch"
          aria-checked="false"
          aria-label={toggleAriaLabel}
          data-prices={plansJson}
        >
          <span class="pricing-toggle__switch-thumb"></span>
        </button>
        <span class="pricing-toggle__switch-label" data-period="annual">
          {annualLabel}
          {annualSavings && <span class="pricing-toggle__savings">{annualSavings}</span>}
        </span>
      </div>
    </div>

    <!-- Plans Grid -->
    <div class="pricing-toggle__grid">
      {plans.map((plan, i) => (
        <div class:list={["pricing-toggle__card", plan.highlighted && "pricing-toggle__card--highlighted"]}>
          {plan.highlighted && <div class="pricing-toggle__popular">{popularBadge}</div>}
          <h3 class="pricing-toggle__plan-name">{plan.name}</h3>
          <div class="pricing-toggle__price" data-plan-index={i}>
            <span class="pricing-toggle__amount">{plan.monthlyPrice}</span>
            <span class="pricing-toggle__period">/ mo</span>
          </div>
          {plan.description && <p class="pricing-toggle__plan-desc">{plan.description}</p>}
          <ul class="pricing-toggle__features">
            {plan.features.map((f) => (
              <li class="pricing-toggle__feature">
                <svg class="pricing-toggle__check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={plan.ctaHref || "#"}
            class:list={["pricing-toggle__cta", plan.highlighted && "pricing-toggle__cta--primary"]}
          >
            {plan.ctaText || "Get Started"}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initPricingToggle() {
    const toggle = document.querySelector(".pricing-toggle__switch") as HTMLButtonElement;
    if (!toggle) return;

    const prices = JSON.parse(toggle.dataset.prices || "[]");
    const labels = document.querySelectorAll(".pricing-toggle__switch-label");
    let isAnnual = false;

    toggle.addEventListener("click", () => {
      isAnnual = !isAnnual;
      toggle.setAttribute("aria-checked", String(isAnnual));
      toggle.classList.toggle("pricing-toggle__switch--active", isAnnual);

      // Update labels
      labels.forEach((label) => {
        const period = (label as HTMLElement).dataset.period;
        label.classList.toggle("pricing-toggle__switch-label--active", 
          (period === "annual" && isAnnual) || (period === "monthly" && !isAnnual)
        );
      });

      // Update prices
      document.querySelectorAll<HTMLElement>(".pricing-toggle__price").forEach((el) => {
        const idx = parseInt(el.dataset.planIndex || "0", 10);
        const amount = el.querySelector(".pricing-toggle__amount");
        if (amount && prices[idx]) {
          amount.textContent = isAnnual ? prices[idx].annual : prices[idx].monthly;
        }
      });
    });
  }

  initPricingToggle();
  document.addEventListener("astro:after-swap", initPricingToggle);
</script>

<style>
  @import "../../styles/sections/pricing-toggle.css";
</style>
