{
  "schemaVersion": 1,
  "name": "stats-strip",
  "version": "1.0.0",
  "type": "section",
  "description": "Horizontal strip of key metrics with animated count-up on scroll. Social proof numbers for landing pages.",
  "category": "social-proof",
  "tags": ["stats", "metrics", "social-proof", "numbers", "count-up"],
  "dependencies": {},
  "requires": [],
  "conflicts": [],
  "envVars": [],
  "variants": ["default", "compact", "bordered"],
  "slots": [],
  "files": [
    {
      "source": "stats-strip.astro",
      "destination": "src/components/sections/stats-strip.astro"
    },
    {
      "source": "stats-strip.css",
      "destination": "src/styles/sections/stats-strip.css"
    }
  ],
  "ai": {
    "whenToUse": "Use between hero and features sections as social proof. Best for showcasing key metrics like user counts, uptime percentages, customer numbers, or product stats that build credibility.",
    "whenNotToUse": "Don't use if you have fewer than 3 meaningful metrics. Avoid on pages where numbers aren't a selling point (e.g. purely content/editorial sites).",
    "pairsWith": ["hero-gradient", "hero-split", "hero-video", "features-grid", "features-bento"],
    "contentSlots": {
      "items": {
        "type": "array",
        "description": "Array of stat items to display in the strip",
        "minItems": 3,
        "maxItems": 8,
        "items": {
          "value": {
            "type": "string",
            "description": "The stat value (e.g. '99.9%', '50K+', '24/7')"
          },
          "label": {
            "type": "string",
            "description": "Short label describing the stat"
          },
          "accent": {
            "type": "boolean",
            "description": "Whether to highlight this stat with the accent color"
          }
        },
        "example": [
          { "value": "10K+", "label": "Active Users", "accent": true },
          { "value": "99.9%", "label": "Uptime", "accent": false },
          { "value": "150+", "label": "Countries", "accent": false },
          { "value": "4.9", "label": "Star Rating", "accent": false },
          { "value": "24/7", "label": "Support", "accent": true }
        ]
      }
    }
  }
}
