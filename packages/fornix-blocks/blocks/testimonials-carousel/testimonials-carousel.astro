---
/**
 * Testimonials Carousel — scrolling testimonial carousel with social proof.
 *
 * ALL text is sourced from the content collection (zero hardcoded strings).
 * Uses CSS scroll-snap for native carousel behavior (no JS library).
 */
import { getEntry } from "astro:content";

interface Testimonial {
  quote: string;
  name: string;
  role: string;
  avatar: string;
}

const locale = Astro.currentLocale ?? "en";
const entry = await getEntry("sections", `${locale}/testimonials-carousel`);
const { headline } = entry?.data ?? {
  headline: "",
};
const testimonials = (entry?.data?.testimonials ?? []) as Testimonial[];
---

<section class="testimonials-carousel">
  {headline && (
    <h2 class="testimonials-carousel__headline">{headline}</h2>
  )}
  <div class="testimonials-carousel__track">
    {testimonials.map((item) => (
      <div class="testimonials-carousel__slide">
        <blockquote class="testimonials-carousel__quote">{item.quote}</blockquote>
        <div class="testimonials-carousel__author">
          {item.avatar && (
            <img
              src={item.avatar}
              alt={item.name}
              class="testimonials-carousel__avatar"
              width="48"
              height="48"
              loading="lazy"
            />
          )}
          <div>
            <span class="testimonials-carousel__name">{item.name}</span>
            <span class="testimonials-carousel__role">{item.role}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  @import "../../styles/sections/testimonials-carousel.css";
</style>
