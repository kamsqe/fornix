---
/**
 * Testimonials Grid — quote cards in a responsive grid.
 *
 * Composes: Section, Container, Headline, Eyebrow, Card, Icon.
 *
 * Avatar fallback: if no image is provided, auto-generate a two-letter
 * monogram from the author's name on a tinted background — looks intentional,
 * not broken.
 */
import { getEntry } from "astro:content";
import Section from "../primitives/Section.astro";
import Container from "../primitives/Container.astro";
import Headline from "../primitives/Headline.astro";
import Eyebrow from "../primitives/Eyebrow.astro";
import Card from "../primitives/Card.astro";
import Icon from "../primitives/Icon.astro";
import { site } from "../../site.config";

interface TestimonialItem {
  quote: string;
  author: string;
  role?: string;
  company?: string;
  avatar?: string;
  rating?: number;
}

const locale = Astro.currentLocale ?? site.locale.default;
const entry = await getEntry("sections", `${locale}/testimonials-grid`);
const data = (entry?.data ?? {}) as {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  items?: TestimonialItem[];
};

const eyebrow = data.eyebrow ?? "";
const headline = data.headline ?? "";
const subheadline = data.subheadline ?? "";
const items = (data.items ?? []) as TestimonialItem[];

function initials(name: string): string {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
  return (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
}
---

<Section>
  <Container size="wide">
    <header class="fnx-testimonials__header">
      {eyebrow && <Eyebrow align="center">{eyebrow}</Eyebrow>}
      {headline && (
        <Headline level={2} align="center" measure="comfortable">
          {headline}
        </Headline>
      )}
      {subheadline && <p class="fnx-testimonials__sub">{subheadline}</p>}
    </header>

    <div class="fnx-testimonials__grid">
      {items.map((item) => (
        <Card variant="bordered" class="fnx-testimonials__card">
          {item.rating && item.rating > 0 && (
            <div class="fnx-testimonials__rating" aria-label={`${item.rating} out of 5`}>
              {Array.from({ length: Math.round(item.rating) }).map(() => (
                <Icon name="star" size="0.875rem" />
              ))}
            </div>
          )}
          <blockquote class="fnx-testimonials__quote">{item.quote}</blockquote>
          <div class="fnx-testimonials__author-row">
            <div class="fnx-testimonials__avatar" aria-hidden="true">
              {item.avatar
                ? <img src={item.avatar} alt="" class="fnx-testimonials__avatar-img" loading="lazy" />
                : <span class="fnx-testimonials__avatar-initials">{initials(item.author)}</span>
              }
            </div>
            <div class="fnx-testimonials__author-meta">
              <div class="fnx-testimonials__author-name">{item.author}</div>
              {(item.role || item.company) && (
                <div class="fnx-testimonials__author-role">
                  {item.role}{item.role && item.company ? ", " : ""}{item.company}
                </div>
              )}
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Container>
</Section>

<style>
  .fnx-testimonials__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    margin-bottom: 3rem;
  }

  .fnx-testimonials__sub {
    margin: 0;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }

  .fnx-testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .fnx-testimonials__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .fnx-testimonials__rating {
    display: inline-flex;
    gap: 0.125rem;
    color: var(--color-accent);
  }

  .fnx-testimonials__quote {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-foreground);
    text-wrap: pretty;
  }

  .fnx-testimonials__author-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
  }

  .fnx-testimonials__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-primary) 18%, transparent);
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .fnx-testimonials__avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fnx-testimonials__avatar-initials {
    font-family: var(--font-headline);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .fnx-testimonials__author-name {
    font-family: var(--font-headline);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground);
  }

  .fnx-testimonials__author-role {
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
    margin-top: 0.125rem;
  }

  @media (min-width: 640px) {
    .fnx-testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .fnx-testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
